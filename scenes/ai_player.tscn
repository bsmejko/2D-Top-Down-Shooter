[sub_resource type="CSharpScript" id="CSharpScript_fxsoi"]
script/source = "using Godot;
using System;

public partial class ai_player : CharacterBody2D
{
    public CharacterBody2D TargetToChase;  // Ensure this is set to the player node in the inspector

    private const float SPEED = 2000f;
    private const float STOP_DISTANCE = 1600f;  // Distance at which AI should stop
    private const float REACTIVATE_DISTANCE = 1800f;  // Distance to reactivate AI if it gets too close

    private Vector2 _previousTargetPosition;  // To track the player's last position
    private bool _isPlayerMoving = false;     // Flag to detect player movement

    public override void _Ready()
    {
        SetPhysicsProcess(true);
        GD.Print(\"AI Ready\");
    }

    // Custom algorithm to check if the target is moving
    private bool IsTargetMoving()
    {
        // Compare the player's current position with the last position
        bool isMoving = !TargetToChase.GlobalPosition.IsEqualApprox(_previousTargetPosition);
        _previousTargetPosition = TargetToChase.GlobalPosition;  // Update for next check
        return isMoving;
    }

    private void PlayAnimation()
    {
        var animatedSprite = GetNode<AnimatedSprite2D>(\"AnimatedSprite2D\");
        float directionX = Velocity.X;
        float directionY = Velocity.Y;
        bool flip = animatedSprite.FlipH;

        if (directionX > 0)
        {
            animatedSprite.Play(\"right\");
            animatedSprite.FlipH = false;
        }
        else if (directionX < 0)
        {
            animatedSprite.Play(\"left\");
            animatedSprite.FlipH = true;
        }
        else if (directionY != 0 && !flip)
        {
            animatedSprite.Play(\"right\");
        }
        else if (directionY != 0 && flip)
        {
            animatedSprite.Play(\"left\");
        }
        else
        {
            animatedSprite.Play(\"Idle\");
        }
    }

    public override void _PhysicsProcess(double delta)
    {
        if (TargetToChase == null)
        {
            GD.Print(\"No target to chase!\");
            return;
        }

        // Calculate distance between AI and player
        float distanceToTarget = GlobalPosition.DistanceTo(TargetToChase.GlobalPosition);
        GD.Print($\"Distance to target: {distanceToTarget}\");

        // Check if the player is moving
        _isPlayerMoving = IsTargetMoving();

        if (distanceToTarget <= STOP_DISTANCE)
        {
            // If AI is within stopping distance and the player is stationary, stop moving
            if (!_isPlayerMoving)
            {
                Velocity = Vector2.Zero;
            }
            else
            {
                // If player is moving, AI should slightly back off to maintain STOP_DISTANCE
                Vector2 directionAwayFromPlayer = GlobalPosition.DirectionTo(TargetToChase.GlobalPosition).Normalized() * -SPEED * (float)delta;
                Velocity = directionAwayFromPlayer;
            }
        }
        else
        {
            // If AI is beyond stopping distance, move towards the player
            Vector2 directionToPlayer = GlobalPosition.DirectionTo(TargetToChase.GlobalPosition).Normalized() * SPEED * (float)delta;
            Velocity = directionToPlayer;
        }

        GD.Print($\"Moving AI with velocity: {Velocity}\");
        MoveAndSlide();
        PlayAnimation();
    }
}
"

